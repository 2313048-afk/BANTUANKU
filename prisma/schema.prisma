generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Roles {
  id_role   String  @id @map("id_role")
  role_name String  @map("role_name")
  users     Users[]

  @@map("ROLES")
}

model Users {
  user_id  String  @id @map("user_id")
  username String? @unique @map("username")
  password String? @map("password")
  id_role  String? @map("id_role")

  role Roles? @relation(fields: [id_role], references: [id_role])
  citizens           CitizenData[]
  adminValidations    DataValidation[]   @relation("AdminUser")
  governmentReports   DistributionReport[] @relation("GovernmentUser")

  @@map("USERS")
}

model CitizenData {
  citizen_id         String   @id @map("citizen_id")
  user_id            String?  @map("user_id")
  id_rt              String?  @map("id_rt")
  id_card_number     Decimal? @map("id_card_number")
  birth_date         DateTime? @map("birth_date")
  gender             String?  @map("gender")
  age                Int?     @map("age")
  address            String?  @map("address")
  family_card_number Decimal? @map("family_card_number")
  occupation         String?  @map("occupation")
  monthly_income     String?  @map("monthly_income")
  aid_status         String?  @map("aid_status")

  user Users? @relation(fields: [user_id], references: [user_id])
  aidRecipients  AidRecipient[]
  validations    DataValidation[]

  @@map("CITIZEN_DATA")
}

model AidProgram {
  aid_id      String   @id @map("aid_id")
  aid_name    String?  @map("aid_name")
  description String?  @map("description")
  start_date  DateTime? @map("start_date")
  end_date    DateTime? @map("end_date")
  status      String?  @map("status")

  recipients   AidRecipient[]
  reports      DistributionReport[]

  @@map("AID_PROGRAM")
}

model AidRecipient {
  recipient_id     String   @id @map("recipient_id")
  citizen_id       String?  @map("citizen_id")
  aid_id           String?  @map("aid_id")
  receive_date     DateTime? @map("receive_date")
  recipient_status String?  @map("recipient_status")

  citizen CitizenData? @relation(fields: [citizen_id], references: [citizen_id])
  aid      AidProgram?  @relation(fields: [aid_id], references: [aid_id])

  @@map("AID_RECIPIENT")
}

model DataValidation {
  validation_id     String   @id @map("validation_id")
  admin_user_id     String?  @map("admin_user_id")
  citizen_id        String?  @map("citizen_id")
  validation_result Boolean? @map("validation_result")
  notes             String?  @map("notes")

  adminUser   Users?       @relation("AdminUser", fields: [admin_user_id], references: [user_id])
  citizenData CitizenData? @relation(fields: [citizen_id], references: [citizen_id])

  @@map("DATA_VALIDATION")
}

model DistributionReport {
  report_id          String   @id @map("report_id")
  government_user_id String?  @map("government_user_id")
  aid_id             String?  @map("aid_id")
  total_recipients   Int?     @map("total_recipients")
  report_date        DateTime? @map("report_date")

  governmentUser Users?     @relation("GovernmentUser", fields: [government_user_id], references: [user_id])
  aidProgram     AidProgram? @relation(fields: [aid_id], references: [aid_id])

  @@map("DISTRIBUTION_REPORT")
}
